PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# Note: Keep the secret key strictly on the backend. Never expose it to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key
SUPABASE_JWKS_URL=

# Cron Endpoint Protection
# Header: x-cron-secret or Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-secret-cron-token-here

# Target Mock Store
MOCK_STORE_URL=https://demo.inelabteamdev.com
